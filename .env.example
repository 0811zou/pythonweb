# 示例生产环境配置（请复制为 .env.production 并填写真实值）
SECRET_KEY=replace-with-secure-random-string
DEBUG=0
SITE_BASE_URL=https://your.domain.com
POSTGRES_DB=agro
POSTGRES_USER=agro
POSTGRES_PASSWORD=replace-with-strong-password
DATABASE_URL=postgres://agro:replace-with-strong-password@db:5432/agro
ALLOWED_HOSTS=your.domain.com
CSRF_TRUSTED_ORIGINS=https://your.domain.com
STATIC_ROOT=/app/static
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=1
SECURE_HSTS_PRELOAD=1
# 可选：用于 deploy.sh 自动创建管理员
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
